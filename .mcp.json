{
  "mcpServers": {
    "redis": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/redis/mcp-redis.git",
        "redis-mcp-server",
        "--url",
        "${AIVEN_REDIS_URL}"
      ]
    },
    "aiven": {
      "command": "npx",
      "args": ["-y", "mcp-aiven"],
      "env": {
        "AIVEN_TOKEN": "${AIVEN_TOKEN}"
      }
    },
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp"
    },
    "n8n": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "${N8N_API_URL}/mcp-server/http",
        "--header",
        "Authorization: Bearer ${N8N_MCP_TOKEN}",
        "--transport",
        "http-only"
      ]
    }
  }
}
